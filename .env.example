# Copier vers .env.local et remplir. Ne jamais committer de vraies valeurs.

DATABASE_TCP_URL=postgresql://user:password@host:5432/postgres
APP_URL=http://localhost:3000
SESSION_SECRET=
CRON_SECRET=

# Clé de chiffrement AES-256-GCM des secrets au repos (mot de passe SMTP, jetons Gmail,
# URL du webhook Slack). 64 caractères hexadécimaux : openssl rand -hex 32
# Sans elle, l'URL du webhook Slack ne peut pas être enregistrée.
ENCRYPTION_KEY=

ANTHROPIC_API_KEY=
